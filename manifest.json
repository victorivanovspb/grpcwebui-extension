{
  "name"        : "grpcwebui-extension",
  "description" : "Расширение для более удобной работы с grpc-web-ui",
  "version"     : "0.3",
  "manifest_version" : 3,
  "icons" : {
    "16"  : "assets/images/logo-128.png",
    "48"  : "assets/images/logo-128.png",
    "128" : "assets/images/logo-128.png"
  },
  "content_scripts" : [{
    "matches" : [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
    "css"     : ["src/css/main.css", "src/css/jquery.json-viewer.css"],
    "js"      : ["src/js/lib/jquery-3.7.1.min.js", "src/js/lib/jquery.json-viewer.js", "src/js/contentscript.js", "src/js/auth.js"]
  }],
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://spotify-backstage-kube-proxy.ingress.dev.m2.ru/*",
    "https://spotify-backstage-kube-proxy.ingress.test.m2.ru/*"
  ],
  "homepage_url": "https://github.com/victorivanovspb/grpcwebui-extension"
}
